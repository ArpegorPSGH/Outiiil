{
	"manifest_version": 3,
	"name": "Outiiil",
	"version": "3.22",
	"description": "Extension pour www.fourmizzz.fr.",
	"icons": {
		"48": "images/icons/gear_48.png",
		"96": "images/icons/gear_96.png"
	},
	"action": {
		"default_icon": "images/icons/gear_48.png"
	},
	"author": "Arpegor",
	"host_permissions": [
		"http://*.fourmizzz.fr/*",
		"http://outiiil.fr/",
		"https://arpegorpsgh.github.io/*"
	],
	"permissions": [
		"storage"
	],
	"content_scripts": [
		{
			"matches": [
				"http://*.fourmizzz.fr/*"
			],
			"js": [
				"js/loader.js"
			],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"images/*",
				"css/*",
				"js/*",
				"dist/*",
				"scripts/*",
				"manifest.json"
			],
			"matches": [
				"http://*.fourmizzz.fr/*"
			]
		}
	]
}